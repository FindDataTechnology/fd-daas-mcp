# alerts-mcp — social/chat channel credentials.
# Copy the keys you need into the ROOT .env (root .env is loaded first; this
# per-MCP .env overrides with override=True). All keys are OPTIONAL — an
# unconfigured channel simply reports `configured: false` and is skipped (its
# failure is recorded in alert_events.channels_results). Never put real secrets
# in this file — it is a template.

# ── Telegram (Bot API) ──────────────────────────────────────────
ALERTS_TELEGRAM_BOT_TOKEN=
# Default chat id to send to (per-rule override via channels_json: {"telegram":{"chat_id":"…"}})
ALERTS_TELEGRAM_CHAT_ID=

# ── Discord (incoming webhook) ──────────────────────────────────
ALERTS_DISCORD_WEBHOOK_URL=

# ── Slack (incoming webhook) ────────────────────────────────────
ALERTS_SLACK_WEBHOOK_URL=

# ── DingTalk 钉钉 (custom robot webhook + optional sign secret) ─
ALERTS_DINGTALK_WEBHOOK_URL=
ALERTS_DINGTALK_SECRET=

# ── Feishu 飞书 (custom bot webhook + optional sign secret) ─────
ALERTS_FEISHU_WEBHOOK_URL=
ALERTS_FEISHU_SECRET=

# ── 企业微信 WeCom (group robot webhook; key is in the URL) ─────
ALERTS_WECOM_WEBHOOK_URL=
# Reserved for a future signing mode; not currently used by send.
ALERTS_WECOM_SECRET=

# ── Twitter/X (OAuth 1.0a user context) ─────────────────────────
ALERTS_TWITTER_CONSUMER_KEY=
ALERTS_TWITTER_CONSUMER_SECRET=
ALERTS_TWITTER_ACCESS_TOKEN=
ALERTS_TWITTER_ACCESS_TOKEN_SECRET=
